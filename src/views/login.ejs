<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= etiqueta %></title>

    <%- include ('Partial/head.ejs') %>
</head>
<body class="login">




    <%- include ('Partial/navigation') %>

<main class="container vh-100 d-flex flex-column justify-content-center align-items-center">


    <section class="text-center mb-4">
        <h1 class="h3 text-white">Iniciar Sesion</h1>
    </section>


    <div class="login-card p-4 bg-white rounded shadow-lg" style="width: 100%; max-width: 400px;">

        // formulario principal de login
        <form action="/login" method="post">
            <% if (mensaje) { %>
                <div class="error">
                    <%= mensaje %>
                </div>
            <% } %>

            <div class="mb-3">
                <label for="username" class="form-label">Usuario</label>
                <input type="text" class="form-control" id="username"  name="usuario" placeholder="Ingrese su usuario">
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Contraseña</label>
                <input type="password" class="form-control" id="password" placeholder="Ingrese su contraseña">
            </div>
            <button type="submit" class="btn btn-primary w-100">Iniciar Sesion</button>
            <button type="reset" class="btn btn-secondary w-100">Limpiar</button>

            <div class="mt-3 text-center">
                <a href="/registro" class="text-decoration-none">¿No tienes una cuenta? Regístrate</a>
            </div>
            <!-- Enlaces de recuperación -->
            <div class="links text-center mt-3 d-flex flex-column gap-1">
                <a href="/recuperar-password" class="text-decoration-none">Restablecer contraseña</a>
                <a href="/recordar-usuario" class="text-decoration-none">Recordar Usuario</a>
            </div>

        </form>

        <div class="mt-3 text-center">
            <a href="/" class="btn btn-secondary w-100">Volver al inicio</a>


    </div>
</main>
    <%- include ('Partial/footer.ejs') %>
</body>
</html>

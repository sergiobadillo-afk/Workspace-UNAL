<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= etiqueta %></title>
    <%- include ('Partial/head.ejs') %>
</head>
<body>
    <%- include ('Partial/navigation.ejs') %>

    <div class="container vh-100 d-flex justify-content-center align-items-center">
        <div class="contact-card">
            <h1>Escribenos</h1>

            <form class="contact-form">
                <div class="field-group">
                    <label for="nombre">Nombre "Requerido"</label>
                    <input type="text" id="nombre" placeholder="dsdsds">
                </div>

                <div class="field-group">
                    <label for="email">Correo electronico "requerido"</label>
                    <input type="email" id="email" placeholder="dsdsd">
                </div>

                <div class="field-group">
                    <label for="asunto">Asunto "Requerido"</label>
                    <input type="text" id="asunto" placeholder="sdsdsds">
                </div>

                <div class="mb-3">
                    <label for="mensaje">Mensaje "Requerido"</label>
                    <textarea name="mensaje" rows="3" class="form-control" placeholder="Por favor escriba un mensaje"></textarea>
                </div>


                <button type="submit">Enviar</button>
                <button type="reset">Limpiar</button>

            </form>
        </div>
    </div>

    <%- include ('Partial/footer.ejs') %>
</body>
</html>